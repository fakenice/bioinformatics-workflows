{
  "id": "prs",
  "name": "Polygenic Risk Score",
  "nameZH": "多基因风险评分分析",
  "category": "dna",
  "tags": [
    "PRS",
    "多基因风险评分",
    "PRSice",
    "LDpred2",
    "PRS-CS",
    "风险预测"
  ],
  "overview": "利用 GWAS summary statistics 预测个体遗传风险。支持 Clumping+Thresholding（PRSice-2）、Bayesian 连续收缩（LDpred2、PRS-CS）三种方法，覆盖数据准备、QC、PRS 计算和模型评估。",
  "icon": "dna",
  "sources": [
    {
      "id": "prsice",
      "name": "PRSice-2",
      "type": "official",
      "url": "https://www.prsice.info/",
      "steps": [
        {
          "id": "step-1",
          "name": "准备数据",
          "description": "Base data: GWAS summary statistics（β, SE, P, SNP, EA, OA）；Target data: 个体基因型（PLINK format）",
          "tools": [
            {
              "name": "PLINK",
              "version": "1.9 / 2.0",
              "params": "--bfile",
              "docker": ""
            }
          ],
          "notes": "Target data 需为 PLINK 格式（bed/bim/fam）。",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "step-2",
          "name": "质量控制",
          "description": "Base: 移除低质量 SNP（MAF < 0.01, INFO < 0.8）；Target: 标准 GWAS QC；正链对齐",
          "tools": [
            {
              "name": "PLINK / QCTOOL",
              "version": "2.0 / 2",
              "params": "--maf 0.01 --info 0.8",
              "docker": ""
            }
          ],
          "notes": "Base data 过滤：MAF > 0.01, INFO > 0.8。",
          "position": {
            "x": 0,
            "y": 120
          }
        },
        {
          "id": "step-3",
          "name": "PRS 计算",
          "description": "C+T（PRSice-2）/ Bayesian 连续收缩（LDpred2, PRS-CS）",
          "tools": [
            {
              "name": "PRSice-2",
              "version": "2.3+",
              "params": "--bar-levels 5e-8,1e-6,...,1 --fastscore",
              "docker": ""
            },
            {
              "name": "LDpred2 (bigsnpr)",
              "version": "1.12+",
              "params": "snp_ldpred2_auto()",
              "docker": ""
            },
            {
              "name": "PRS-CS",
              "version": "1.0",
              "params": "--n_gwas=<N>",
              "docker": ""
            }
          ],
          "notes": "C+T 方法。--fastscore 只计算指定阈值。 Bayesian 自动调参，推荐。需要 LD 参考面板。 Bayesian 连续收缩，大样本推荐。PRS-CS-auto 自动调参。",
          "position": {
            "x": 0,
            "y": 240
          }
        },
        {
          "id": "step-4",
          "name": "模型评估",
          "description": "R² / AUC / OR per SD / 十折交叉验证 / 分层分析",
          "tools": [
            {
              "name": "R / PLINK",
              "version": "4.3+ / 2.0",
              "params": "--score",
              "docker": ""
            }
          ],
          "notes": "评估指标：R²（连续）、AUC（二分类）、OR per SD。",
          "position": {
            "x": 0,
            "y": 360
          }
        }
      ],
      "references": [
        {
          "title": "PRSice-2: Polygenic Risk Score software (Choi & O'Reilly, 2019)",
          "url": "https://doi.org/10.1093/gigascience/giz082",
          "type": "paper"
        },
        {
          "title": "LDpred2: better, faster, stronger (Privé et al., 2021)",
          "url": "https://doi.org/10.1093/bioinformatics/btaa1029",
          "type": "paper"
        },
        {
          "title": "PRS-CS: polygenic prediction via Bayesian regression (Ge et al., 2019)",
          "url": "https://doi.org/10.1038/s41467-019-09718-5",
          "type": "paper"
        },
        {
          "title": "PRSice-2 Documentation",
          "url": "https://www.prsice.info/",
          "type": "official"
        }
      ]
    }
  ]
}
