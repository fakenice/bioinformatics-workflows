{
  "id": "gwas",
  "name": "GWAS Case-Control",
  "nameZH": "病例对照 GWAS 分析",
  "category": "dna",
  "tags": [
    "GWAS",
    "病例对照",
    "SAIGE",
    "REGENIE",
    "PLINK",
    "群体遗传"
  ],
  "overview": "全基因组关联分析标准流程，覆盖基因型 QC、群体分层校正、关联分析（PLINK/SAIGE/REGENIE）和结果解读。适用于常见变异（MAF > 1%）与二分类/连续表型的关联检测。",
  "icon": "dna",
  "sources": [
    {
      "id": "plink",
      "name": "PLINK GWAS",
      "type": "official",
      "url": "https://www.cog-genomics.org/plink/",
      "steps": [
        {
          "id": "step-1",
          "name": "基因型数据 QC",
          "description": "样本 QC（缺失率、性别检查、杂合度、亲缘关系）+ 变异 QC（缺失率、MAF、HWE、差异缺失）",
          "tools": [
            {
              "name": "PLINK",
              "version": "1.9 / 2.0",
              "params": "--mind 0.03 --geno 0.02 --maf 0.01 --hwe 1e-6",
              "docker": ""
            },
            {
              "name": "PLINK --king",
              "version": "2.0",
              "params": "--king-cutoff 0.0884",
              "docker": ""
            }
          ],
          "notes": "样本缺失率 < 3%，变异缺失率 < 2%，MAF > 1%，HWE P > 1e-6。 移除二级以上亲属（PI_HAT < 0.0884）。",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "step-2",
          "name": "群体分层校正",
          "description": "PCA 主成分分析，去除异常样本，PC1-PC10 作为协变量",
          "tools": [
            {
              "name": "GCTA / PLINK 2.0",
              "version": "1.94 / 2.0",
              "params": "--pca 20",
              "docker": ""
            }
          ],
          "notes": "PCA 计算前 20 个主成分。检查 PC1 vs PC2 是否有群体异常样本。",
          "position": {
            "x": 0,
            "y": 120
          }
        },
        {
          "id": "step-3",
          "name": "关联分析",
          "description": "二分类表型用逻辑回归（PLINK --logistic / SAIGE / REGENIE），连续表型用线性回归（PLINK --linear / BOLT-LMM）",
          "tools": [
            {
              "name": "PLINK --logistic",
              "version": "1.9",
              "params": "--covar PC1-PC5 --ci 0.95",
              "docker": ""
            },
            {
              "name": "SAIGE",
              "version": "1.3+",
              "params": "step1: fitNULLGLMM, step2: SPAtests",
              "docker": ""
            },
            {
              "name": "REGENIE",
              "version": "3.4+",
              "params": "--step 1 --step 2 --bt",
              "docker": ""
            }
          ],
          "notes": "基础逻辑回归，适合中小样本。 推荐用于大样本 + 病例不平衡。使用 SPA 校正。 两步法，适合 UKB 级别大数据。低内存模式。",
          "position": {
            "x": 0,
            "y": 240
          }
        },
        {
          "id": "step-4",
          "name": "结果解读",
          "description": "Manhattan plot, QQ plot, 基因组膨胀因子 λ_GC, LD clumping + 注释",
          "tools": [
            {
              "name": "LDSC / GCTA",
              "version": "1.0.1 / 1.94",
              "params": "",
              "docker": ""
            }
          ],
          "notes": "计算 λ_GC（目标 0.95-1.05）。Manhattan/QQ 图用 R qqman 包。",
          "position": {
            "x": 0,
            "y": 360
          }
        }
      ],
      "references": [
        {
          "title": "PLINK 1.9 / 2.0 Documentation",
          "url": "https://www.cog-genomics.org/plink/",
          "type": "official"
        },
        {
          "title": "SAIGE: Scalable and accurate generalized mixed model (Zhou et al., 2018)",
          "url": "https://doi.org/10.1038/s41588-018-0184-6",
          "type": "paper"
        },
        {
          "title": "REGENIE: whole-genome regression (Mbatchou et al., 2021)",
          "url": "https://doi.org/10.1038/s41588-021-00870-7",
          "type": "paper"
        },
        {
          "title": "BOLT-LMM: Bayesian mixed model (Loh et al., 2015)",
          "url": "https://doi.org/10.1038/ng.3190",
          "type": "paper"
        }
      ]
    }
  ]
}
