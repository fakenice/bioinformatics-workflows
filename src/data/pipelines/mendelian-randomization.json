{
  "id": "mendelian-randomization",
  "name": "Mendelian Randomization",
  "nameZH": "孟德尔随机化分析",
  "category": "dna",
  "tags": [
    "孟德尔随机化",
    "MR",
    "TwoSampleMR",
    "工具变量",
    "因果推断"
  ],
  "overview": "利用遗传变异作为工具变量评估暴露与结局的因果关系。支持双样本 MR（使用 GWAS summary statistics），覆盖 IV 选择、harmonization、多方法 MR 估计和敏感性分析。",
  "icon": "dna",
  "sources": [
    {
      "id": "twosamplemr",
      "name": "TwoSampleMR (MRC IEU)",
      "type": "official",
      "url": "https://mrcieu.github.io/TwoSampleMR/",
      "steps": [
        {
          "id": "step-1",
          "name": "选择工具变量",
          "description": "从暴露 GWAS 选 IV（P < 5e-8），Clumping（r² < 0.001, 10Mb），检查 F-statistic > 10",
          "tools": [
            {
              "name": "TwoSampleMR R 包",
              "version": "0.6+",
              "params": "extract_instruments(p1=5e-8, clump=T, r2=0.001, kb=10000)",
              "docker": ""
            }
          ],
          "notes": "F-statistic = beta²/se²，要求 F > 10。",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "step-2",
          "name": "提取结局 SNP + Harmonization",
          "description": "提取结局 GWAS 对应 SNP，正链对齐，去除回文 SNP（MAF > 0.4）",
          "tools": [
            {
              "name": "TwoSampleMR harmonise_data()",
              "version": "0.6+",
              "params": "action=2",
              "docker": ""
            }
          ],
          "notes": "action=2 去除回文 SNP（MAF > 0.4）。",
          "position": {
            "x": 0,
            "y": 120
          }
        },
        {
          "id": "step-3",
          "name": "MR 估计",
          "description": "IVW（主方法）、MR-Egger、加权中位数、加权模式、最多似然法",
          "tools": [
            {
              "name": "TwoSampleMR mr()",
              "version": "0.6+",
              "params": "method_list=c('mr_ivw','mr_egger_regression','mr_weighted_median')",
              "docker": ""
            }
          ],
          "notes": "IVW 为主方法。MR-Egger 检验水平多效性。",
          "position": {
            "x": 0,
            "y": 240
          }
        },
        {
          "id": "step-4",
          "name": "敏感性分析",
          "description": "Cochran's Q 异质性、MR-Egger 截距多效性、Leave-one-out、MR-PRESSO 离群值、Steiger 因果方向",
          "tools": [
            {
              "name": "TwoSampleMR mr_heterogeneity()",
              "version": "0.6+",
              "params": "",
              "docker": ""
            },
            {
              "name": "TwoSampleMR mr_pleiotropy_test()",
              "version": "0.6+",
              "params": "",
              "docker": ""
            },
            {
              "name": "MR-PRESSO",
              "version": "1.0",
              "params": "NbDistribution=1000, SignifThreshold=0.05",
              "docker": ""
            },
            {
              "name": "TwoSampleMR mr_leaveoneout()",
              "version": "0.6+",
              "params": "",
              "docker": ""
            }
          ],
          "notes": "Cochran's Q P < 0.05 表示异质性。 MR-Egger 截距 P < 0.05 表示水平多效性。 离群值检测 + 失真检验。 逐个 SNP 剔除，检查是否有单一 SNP 驱动结果。",
          "position": {
            "x": 0,
            "y": 360
          }
        },
        {
          "id": "step-5",
          "name": "多变量 MR (可选)",
          "description": "控制混杂暴露，评估独立因果效应",
          "tools": [
            {
              "name": "TwoSampleMR mv_multivariable_mr()",
              "version": "0.6+",
              "params": "",
              "docker": ""
            }
          ],
          "notes": "多变量 MR 控制混杂暴露。",
          "position": {
            "x": 0,
            "y": 480
          }
        }
      ],
      "references": [
        {
          "title": "TwoSampleMR R package documentation",
          "url": "https://mrcieu.github.io/TwoSampleMR/",
          "type": "official"
        },
        {
          "title": "MR-PRESSO: detection of horizontal pleiotropy (Verbanck et al., 2018)",
          "url": "https://doi.org/10.1038/s41588-018-0099-2",
          "type": "paper"
        },
        {
          "title": "Davey Smith & Hemani (2014) Mendelian randomization",
          "url": "https://doi.org/10.1093/hmg/ddu328",
          "type": "paper"
        },
        {
          "title": "Hemani et al. (2018) The MR-Base platform",
          "url": "https://doi.org/10.7554/eLife.34408",
          "type": "paper"
        }
      ]
    }
  ]
}
