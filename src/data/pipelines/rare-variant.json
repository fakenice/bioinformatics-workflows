{
  "id": "rare-variant",
  "name": "Rare Variant Aggregation",
  "nameZH": "罕见变异聚合分析",
  "category": "dna",
  "tags": [
    "罕见变异",
    "SKAT",
    "SKAT-O",
    "Burden test",
    "ACAT",
    "基因聚合检验"
  ],
  "overview": "针对罕见变异（MAF < 1%）统计效力不足的问题，通过基因级聚合检验提高检测效力。支持 Burden test（方向一致）、SKAT（方差分量）、SKAT-O（自适应混合）和 ACAT（超大样本）。",
  "icon": "dna",
  "sources": [
    {
      "id": "skat",
      "name": "SKAT/SKAT-O",
      "type": "official",
      "url": "https://www.hsph.harvard.edu/skat/",
      "steps": [
        {
          "id": "qc",
          "name": "变异 QC",
          "description": "测序数据变异级质控",
          "tools": [
            {
              "name": "GATK / BCFtools",
              "version": "4.5 / 1.17",
              "params": "QUAL>30, DP>10, MAF<0.01",
              "docker": ""
            }
          ],
          "notes": "QUAL > 30, DP > 10, MAF < 1%。仅保留功能性变异（missense/nonsense/splice-site）。CADD > 20 进一步过滤。",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "annotation",
          "name": "功能注释",
          "description": "基因级注释，确定变异-基因映射",
          "tools": [
            {
              "name": "VEP / ANNOVAR",
              "version": "112 / 2023",
              "params": "--everything",
              "docker": "ensemblorg/ensembl-vep:112"
            }
          ],
          "notes": "按基因分组变异。通常排除 synonymous。可选按功能域分层（如 LOFTEE、REVEL > 0.5）。",
          "position": {
            "x": 0,
            "y": 120
          }
        },
        {
          "id": "null-model",
          "name": "拟合空模型",
          "description": "仅协变量的 null model",
          "tools": [
            {
              "name": "SKAT R 包",
              "version": "2.2+",
              "params": "out_type='D' or 'C'",
              "docker": ""
            }
          ],
          "notes": "SKAT_Null_Model(y ~ PC1+PC2+Age+Sex, out_type='D')。out_type='D' 二分类，'C' 连续。",
          "position": {
            "x": 0,
            "y": 240
          }
        },
        {
          "id": "burden",
          "name": "Burden test",
          "description": "基因内罕见变异计数求和",
          "tools": [
            {
              "name": "SKAT Burden()",
              "version": "2.2+",
              "params": "r.corr=1",
              "docker": ""
            }
          ],
          "notes": "假设基因内所有罕见变异方向一致（同向效应时效力最高）。方向不一致时效力显著下降。",
          "position": {
            "x": 0,
            "y": 360
          }
        },
        {
          "id": "skat",
          "name": "SKAT 检验",
          "description": "方差分量检验",
          "tools": [
            {
              "name": "SKAT SKAT()",
              "version": "2.2+",
              "params": "r.corr=0",
              "docker": ""
            }
          ],
          "notes": "不假设变异方向一致，对双向效应（既有保护性又有致病性变异）效力更高。",
          "position": {
            "x": 0,
            "y": 480
          }
        },
        {
          "id": "skato",
          "name": "SKAT-O（推荐）",
          "description": "Burden + SKAT 自适应混合",
          "tools": [
            {
              "name": "SKAT SKAT()",
              "version": "2.2+",
              "params": "r.corr=NA (adaptive)",
              "docker": ""
            }
          ],
          "notes": "数据自适应地在 Burden 和 SKAT 间选择最优权重。方向未知时的默认推荐方法。",
          "position": {
            "x": 0,
            "y": 600
          }
        },
        {
          "id": "acat",
          "name": "ACAT（大样本）",
          "description": "从单个变异 P 值聚合",
          "tools": [
            {
              "name": "ACAT R 包",
              "version": "",
              "params": "",
              "docker": ""
            }
          ],
          "notes": "计算效率高，适合百万级样本和全基因组扫描。对变异间 LD 不敏感。",
          "position": {
            "x": 0,
            "y": 720
          }
        },
        {
          "id": "fdr",
          "name": "多重检验校正",
          "description": "FDR 校正 + 结果解读",
          "tools": [
            {
              "name": "R stats::p.adjust()",
              "version": "",
              "params": "method='BH'",
              "docker": ""
            }
          ],
          "notes": "全基因组按基因数做 Benjamini-Hochberg FDR 校正。显著性：FDR q < 0.05。候选基因交集 ClinVar/OMIM 验证。",
          "position": {
            "x": 0,
            "y": 840
          }
        }
      ],
      "references": [
        {
          "title": "SKAT: Sequence Kernel Association Test (Wu et al., 2011)",
          "url": "https://doi.org/10.1016/j.ajhg.2011.05.029",
          "type": "paper"
        },
        {
          "title": "SKAT-O: Optimal unified association test (Lee et al., 2012)",
          "url": "https://doi.org/10.1093/biostatistics/kxs014",
          "type": "paper"
        },
        {
          "title": "ACAT: Aggregated Cauchy Association Test (Liu et al., 2019)",
          "url": "https://doi.org/10.1016/j.ajhg.2018.12.002",
          "type": "paper"
        },
        {
          "title": "Rare-variant association analysis: study designs (Lee et al., 2014)",
          "url": "https://doi.org/10.1146/annurev-genom-091212-153421",
          "type": "paper"
        }
      ]
    }
  ]
}