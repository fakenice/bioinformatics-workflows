{
  "meta": {
    "version": "1.0.0",
    "created": "2026-07-29",
    "description": "Standardized test cases for evaluating FlowSeq Skill vs bare LLM. Each case maps to a real pipeline in the knowledge base.",
    "total_pipelines": 14,
    "total_cases": 20
  },
  "test_cases": [
    {
      "id": "TC-001",
      "scenario": "我需要分析一个家系 trio 样本（先证者+父母）的 WGS 数据，检测 de novo 突变来诊断罕见遗传病。",
      "expected_pipeline": "family-trio-wgs",
      "expected_tools": ["GATK HaplotypeCaller", "GATK GenotypeGVCFs", "VEP", "DeNovoGear"],
      "expected_versions": {"GATK": "4.4+", "VEP": "110+"},
      "expected_docker": ["broadinstitute/gatk:4.4.0.0", "ensemblorg/ensembl-vep:110"],
      "expected_qc": ["de novo rate ~1.0-1.5e-8/site/generation", "WGS coverage >= 30x"],
      "difficulty": "easy",
      "category": "dna"
    },
    {
      "id": "TC-002",
      "scenario": "我有 5000 例二型糖尿病病例和 5000 例健康对照的基因分型芯片数据，想做全基因组关联分析。样本量较大且病例对照不平衡。",
      "expected_pipeline": "gwas",
      "expected_tools": ["PLINK", "SAIGE", "REGENIE", "GCTA"],
      "expected_versions": {"SAIGE": "1.3+", "REGENIE": "3.4+", "PLINK": "1.9/2.0"},
      "expected_docker": [],
      "expected_qc": ["Sample missingness < 3%", "MAF > 1%", "HWE P > 1e-6", "lambda_GC 0.95-1.05"],
      "difficulty": "medium",
      "category": "dna"
    },
    {
      "id": "TC-003",
      "scenario": "我想用公开的 GWAS 汇总统计数据做孟德尔随机化分析，研究 BMI 对冠心病的因果效应。需要用两样本 MR 方法。",
      "expected_pipeline": "mendelian-randomization",
      "expected_tools": ["TwoSampleMR", "MR-PRESSO"],
      "expected_versions": {},
      "expected_docker": [],
      "expected_qc": ["F-statistic > 10", "Cochran's Q heterogeneity test", "MR-Egger intercept test"],
      "difficulty": "medium",
      "category": "dna"
    },
